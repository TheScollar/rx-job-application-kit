# Copy this file to .env and paste your key after the equals sign.
# Get a key in Reactive Resume: Settings -> Security -> API Keys (https://rxresu.me)
# NEVER commit .env. It is gitignored; keep it that way.
REACTIVE_RESUME_API_KEY=

# Optional: only for self-hosted Reactive Resume instances.
# The Applications API (tracking) requires Reactive Resume v5 or newer.
# REACTIVE_RESUME_BASE_URL=https://rxresu.me/api/openapi
